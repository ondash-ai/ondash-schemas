{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project.json",
  "title": "Project MongoDB types",
  "description": "Project and connection domain models",
  "$defs": {
    "ConnectionAccess": {
      "title": "ConnectionAccess",
      "type": "string",
      "enum": ["READ", "WRITE"]
    },
    "ConnectionType": {
      "title": "ConnectionType",
      "type": "string",
      "enum": ["FILESYSTEM", "SQLDATABASE", "EMAIL", "API", "EVENTS", "BANK", "NAV_ONLINE", "EIT_DIGITAL", "GOOGLE_WORKSPACE"]
    },
    "Email": {
      "title": "Email",
      "type": "object",
      "properties": {
        "email": { "type": "string" }
      },
      "required": ["email"]
    },
    "HeadCountAtDate": {
      "title": "HeadCountAtDate",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "headcount": { "type": "integer" }
      },
      "required": ["date", "headcount"]
    },
    "Accountancy": {
      "title": "Accountancy",
      "type": "object",
      "properties": {
        "name": { "type": "string", "default": "" },
        "contact_name": { "type": "string", "default": "" },
        "phone_number": { "type": "string", "default": "" },
        "email": { "type": "string", "default": "" }
      }
    },
    "ProjectInfo": {
      "title": "ProjectInfo",
      "type": "object",
      "properties": {
        "title": { "type": "string", "default": "" },
        "description": { "type": "string", "default": "" },
        "website": { "type": "string", "default": "" },
        "contact": { "type": "string", "default": "" },
        "sector": { "type": "string", "default": "" },
        "logo": { "type": "string", "default": "" },
        "headcount": { "type": "array", "items": { "$ref": "#/$defs/HeadCountAtDate" }, "default": [] },
        "accountancy": { "allOf": [{ "$ref": "#/$defs/Accountancy" }], "default": {} }
      }
    },
    "EmailSesParams": {
      "title": "EmailSesParams",
      "type": "object",
      "properties": {
        "email_address": { "type": "string", "default": "" }
      }
    },
    "EmailSmtpParams": {
      "title": "EmailSmtpParams",
      "type": "object",
      "properties": {
        "host": { "type": "string", "default": "" },
        "port": { "type": "integer", "default": 587 },
        "username": { "type": "string", "default": "" },
        "password": { "type": "string", "default": "" },
        "from_address": { "type": "string", "default": "" },
        "use_tls": { "type": "boolean", "default": true }
      }
    },
    "EmailConnectionParams": {
      "title": "EmailConnectionParams",
      "type": "object",
      "properties": {
        "service_type": { "type": "string", "enum": ["ses", "smtp"], "default": "ses" },
        "ses": { "allOf": [{ "$ref": "#/$defs/EmailSesParams" }], "default": {} },
        "smtp": { "allOf": [{ "$ref": "#/$defs/EmailSmtpParams" }], "default": {} }
      }
    },
    "ConnectionBase": {
      "title": "ConnectionBase",
      "type": "object",
      "properties": {
        "id": { "type": "string", "default": "" },
        "name": { "type": "string" },
        "description": { "type": "string", "default": "" },
        "access": { "allOf": [{ "$ref": "#/$defs/ConnectionAccess" }], "default": "READ" },
        "type": { "$ref": "#/$defs/ConnectionType" },
        "params": { "type": "object", "default": {} },
        "status": { "type": "object", "default": {} },
        "last_updated": { "type": ["string", "null"], "format": "date-time", "default": null }
      },
      "required": ["name", "type"]
    },
    "License": {
      "title": "License",
      "type": "object",
      "properties": {
        "plan": { "type": "string", "default": "free" },
        "status": { "type": "string", "default": "active" },
        "trial_ends_at": { "type": ["string", "null"], "format": "date-time", "default": null },
        "stripe_customer_id": { "type": ["string", "null"], "default": null },
        "stripe_subscription_id": { "type": ["string", "null"], "default": null },
        "current_period_end": { "type": ["string", "null"], "format": "date-time", "default": null }
      }
    },
    "OnleaseAddress": {
      "title": "OnleaseAddress",
      "type": "object",
      "properties": {
        "street": { "type": "string", "default": "" },
        "city": { "type": "string", "default": "" },
        "zip": { "type": "string", "default": "" },
        "country": { "type": "string", "default": "" }
      }
    },
    "OnleasePerson": {
      "title": "OnleasePerson",
      "type": "object",
      "properties": {
        "name": { "type": "string", "default": "" },
        "id_number": { "type": "string", "default": "" },
        "email": { "type": "string", "default": "" },
        "phone": { "type": "string", "default": "" },
        "address": { "type": "string", "default": "" }
      }
    },
    "OnleaseRenter": {
      "title": "OnleaseRenter",
      "description": "Renter identity as extracted from the rental contract",
      "type": "object",
      "properties": {
        "name": { "type": "string", "default": "" },
        "id_number": { "type": "string", "default": "" },
        "address": { "type": "string", "default": "" },
        "email": { "type": "string", "default": "" },
        "phone": { "type": "string", "default": "" },
        "birth_date": { "type": ["string", "null"], "default": null },
        "birth_place": { "type": ["string", "null"], "default": null },
        "mothers_name": { "type": ["string", "null"], "default": null },
        "additional_residents": { "type": "array", "items": { "type": "string" }, "default": [] }
      }
    },
    "OnleaseClause": {
      "title": "OnleaseClause",
      "description": "A numbered clause from the rental contract with an AI-generated title",
      "type": "object",
      "properties": {
        "number": { "type": "integer" },
        "title": { "type": "string", "default": "" },
        "body": { "type": "string", "default": "" }
      },
      "required": ["number"]
    },
    "OnleaseRentContract": {
      "title": "OnleaseRentContract",
      "description": "A rental contract, parsed from a PDF document",
      "type": "object",
      "properties": {
        "id": { "type": "string", "default": "" },
        "status": { "type": "string", "enum": ["active", "expired", "terminated"], "default": "active" },
        "start_date": { "type": ["string", "null"], "default": null },
        "end_date": { "type": ["string", "null"], "default": null },
        "duration_type": { "type": "string", "enum": ["fixed", "indefinite"], "default": "indefinite" },
        "monthly_rent": { "type": ["number", "null"], "default": null },
        "currency": { "type": "string", "default": "HUF" },
        "deposit_months": { "type": "integer", "default": 2 },
        "deposit_amount": { "type": ["number", "null"], "default": null },
        "payment_due_day": { "type": ["integer", "null"], "default": null },
        "payment_due_text": { "type": ["string", "null"], "default": null },
        "payment_method": { "type": ["string", "null"], "enum": ["bank_transfer", "cash", null], "default": null },
        "notice_period_days": { "type": "integer", "default": 90 },
        "indexation": { "type": ["string", "null"], "default": null },
        "renter": { "allOf": [{ "$ref": "#/$defs/OnleaseRenter" }], "default": {} },
        "clauses": { "type": "array", "items": { "$ref": "#/$defs/OnleaseClause" }, "default": [] },
        "document_s3_key": { "type": ["string", "null"], "default": null },
        "signed_at": { "type": ["string", "null"], "default": null },
        "parsed_at": { "type": ["string", "null"], "default": null }
      }
    },
    "OnleaseData": {
      "title": "OnleaseData",
      "description": "App-specific data for onlease projects",
      "type": "object",
      "properties": {
        "owner": { "allOf": [{ "$ref": "#/$defs/OnleasePerson" }], "default": {} },
        "address": { "allOf": [{ "$ref": "#/$defs/OnleaseAddress" }], "default": {} },
        "contracts": { "type": "array", "items": { "$ref": "#/$defs/OnleaseRentContract" }, "default": [] }
      }
    },
    "ProjectMember": {
      "title": "ProjectMember",
      "description": "A user who has been granted access to the project, with an app_type-dependent role. The set of valid role keys per app_type is defined by the backend role registry.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "default": "" },
        "role": { "type": "string", "default": "" },
        "granted_by": { "type": "string", "default": "" },
        "granted_at": { "type": ["string", "null"], "format": "date-time", "default": null }
      },
      "required": ["email", "role"]
    },
    "DProjectBase": {
      "title": "DProjectBase",
      "type": "object",
      "properties": {
        "id": { "type": ["string", "null"], "default": null },
        "version": { "type": "string", "default": "0.3" },
        "admin": { "type": "string", "default": "" },
        "title": { "type": "string", "default": "" },
        "description": { "type": "string", "default": "" },
        "website": { "type": "string", "default": "" },
        "contact": { "type": "string", "default": "" },
        "sector": { "type": "string", "default": "" },
        "logo": { "type": "string", "default": "" },
        "headcount": { "type": "array", "items": { "$ref": "#/$defs/HeadCountAtDate" }, "default": [] },
        "accountancy": { "allOf": [{ "$ref": "#/$defs/Accountancy" }], "default": {} },
        "shared": { "type": "array", "items": { "type": "string" }, "default": [] },
        "members": { "type": "array", "items": { "$ref": "#/$defs/ProjectMember" }, "default": [] },
        "lang": { "type": "string", "default": "en" },
        "pipeline": { "type": "string", "default": "ledger" },
        "chat": { "type": "string", "default": "" },
        "tags": { "type": "array", "items": { "type": "string" }, "default": [] },
        "connections": { "type": "array", "items": { "$ref": "#/$defs/ConnectionBase" }, "default": [] },
        "app_type": { "type": "string", "default": "monitoring" },
        "license": { "allOf": [{ "$ref": "#/$defs/License" }], "default": {} },
        "schema_name": { "type": "string", "default": "" },
        "documents_synced": { "type": "boolean", "default": false },
        "project_email_address": { "type": ["string", "null"], "default": null },
        "onlease": { "allOf": [{ "$ref": "#/$defs/OnleaseData" }], "default": null }
      }
    }
  }
}
